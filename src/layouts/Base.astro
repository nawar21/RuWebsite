---
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import { SITE, CORE_TEAM } from '../data/site';
import { asset } from '../lib/url';

interface Props {
  /** Page title; the home page uses the site title. */
  title?: string;
  description?: string;
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
}

const { title = SITE.title, description = SITE.description, noindex = false } = Astro.props;
const isHome = title === SITE.title;
const shareTitle = isHome ? SITE.shareTitle : title;
const shareDescription = isHome ? SITE.shareDescription : description;
const ogImage = new URL(asset('assets/og.jpg'), Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const founders = CORE_TEAM.filter((p) => p.role.includes('Co-founder'));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="RuRobotics logo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.xHandle} />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={shareDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/png" sizes="32x32" href={asset('assets/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="512x512" href={asset('assets/favicon-512.png')} />
    <link rel="apple-touch-icon" href={asset('assets/apple-touch-icon.png')} />
    <link rel="manifest" href={asset('site.webmanifest')} />

    <script is:inline>document.documentElement.classList.add('js');</script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: SITE.name,
        url: new URL(asset(''), Astro.site).href,
        logo: new URL(asset('assets/favicon-512.png'), Astro.site).href,
        image: ogImage,
        description: SITE.description,
        email: SITE.email,
        address: { '@type': 'PostalAddress', addressLocality: SITE.city, addressCountry: SITE.countryCode },
        founder: founders.map((p) => ({ '@type': 'Person', name: p.name, jobTitle: p.role.split(' · ')[0], sameAs: p.linkedin })),
        sameAs: [SITE.linkedin, SITE.x, SITE.github],
      })}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
