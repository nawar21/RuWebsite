---
{filled[name] ? (
  <svg aria-hidden="true" viewBox="0 0 24 24" width={size} height={size}><path fill="currentColor" d={filled[name]} /></svg>
) : (
  <svg aria-hidden="true" viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    {stroked[name]?.map((d) => <path d={d} />)}
