---
import { NAV } from '../data/site';
import { asset } from '../lib/url';

interface Props {
  /** On the home page links scroll to sections; elsewhere they go back to the home page first. */
  home?: boolean;
}
const { home = true } = Astro.props;
const root = home ? '' : asset('');
---
<a class="announce" href={`${root}#nyc`}>
  <span class="announce__tag">New</span>
  <span>RuRobotics is coming to New York. Now booking factory pilots in NY &amp; NJ</span>
  <span class="announce__arrow" aria-hidden="true">Learn more ›</span>
</a>

<header class="nav">
  <div class="container nav__inner">
    <a class="nav__brand" href={home ? '#top' : asset('')} aria-label="RuRobotics home">
      <img src={asset('assets/logo-mark-dark.png')} alt="" width="56" height="32" />
      <img class="nav__wordmark" src={asset('assets/logo-wordmark-dark.png')} alt="RuRobotics" width="125" height="18" />
    </a>
    <nav aria-label="Primary">
      <ul class="nav__links">
        {NAV.map((l) => (
          <li><a href={`${root}${l.href}`} data-nav={home ? l.href.slice(1) : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
