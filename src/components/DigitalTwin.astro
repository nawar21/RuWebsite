---
import { asset } from '../lib/url';
import { CASES } from '../scripts/twin/cases';
---
<section class="section" id="twin" aria-labelledby="twin-title">
  <div class="container">
    <header class="section__head reveal">
      <p class="eyebrow">Digital twin</p>
      <h2 id="twin-title">Proven in simulation <span class="accent">before your robot moves.</span></h2>
      <p class="lead">A UR5e palletizes an infeed line in a simulated copy of the cell. Every loop it meets ten things that go wrong on real floors, detects each one with a check, and recovers on its own.</p>
    </header>

    <figure class="twin__stage reveal" data-model={asset('models/ur5e.glb')}>
      <div class="twin__view">
        <div class="twin__loading" aria-hidden="true"><span></span></div>
        <div class="twin__top">
          <p class="twin__status" data-tone="run"><span class="twin__lamp" aria-hidden="true"></span><span class="twin__status-text">Loading simulation</span></p>
          <p class="twin__clock" aria-hidden="true">SIM · CELL 01</p>
          <button class="twin__toggle" type="button" hidden>Pause</button>
        </div>
        <div class="twin__banner" hidden>
          <p class="twin__banner-n"></p>
          <p class="twin__banner-title"></p>
          <p class="twin__banner-detail"></p>
        </div>
        <p class="twin__fallback" hidden>The 3D twin needs WebGL. The ten cases it runs are listed below.</p>
      </div>
      <div class="twin__console">
        <dl class="twin__stats">
          <div><dt>Placed</dt><dd data-stat="placed">0</dd></div>
          <div><dt>Rejected</dt><dd data-stat="rejected">0</dd></div>
          <div><dt>Sorted</dt><dd data-stat="sorted">0</dd></div>
          <div><dt>Pallet</dt><dd data-stat="pallet">0/12</dd></div>
          <div><dt>Generation</dt><dd data-stat="generation">1</dd></div>
          <div><dt>Edge cases</dt><dd data-stat="edges">0/10</dd></div>
        </dl>
        <p class="twin__tool">Vacuum 0 kPa · Payload 0.0 kg · Speed 100%</p>
        <div class="twin__log" role="log" aria-live="off" aria-label="Cell event log"></div>
      </div>
      <figcaption>
        Scripted twin: case names follow the RuRobotics failure taxonomy. Drag sideways to look around.
        UR5e model from <a href="https://github.com/google-deepmind/mujoco_menagerie" target="_blank" rel="noopener">MuJoCo Menagerie</a>
        (<a href={asset('models/LICENSE-ur5e.txt')}>BSD-3</a>).
      </figcaption>
    </figure>

    <ol class="twin__cases reveal" aria-label="Edge cases the cell handles">
      {CASES.map((c) => (
        <li class="twin__case" data-case={c.n}>
          <span class="twin__case-n" aria-hidden="true">{c.n}</span>
          <div>
            <h3>{c.title}</h3>
            <p><code>{c.code}</code> {c.detect}</p>
            <p class="twin__case-fix">{c.response}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  // Load three.js and the cell (~200 kB gzip + the 1.1 MB robot model) only when the section nears the viewport.
  const root = document.querySelector<HTMLElement>('#twin .twin__stage');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    || (import.meta.env.DEV && new URLSearchParams(location.search).has('reduced'));

  if (root) {
    const fail = () => {
      root.classList.add('is-failed');
      root.querySelector<HTMLElement>('.twin__fallback')!.hidden = false;
    };
    const load = async () => {
      try {
        const { mountTwin } = await import('../scripts/twin/twin');
        await mountTwin(root, { modelUrl: root.dataset.model!, reduced });
      } catch (err) {
        console.error('Digital twin failed to start', err);
        fail();
      }
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) { io.disconnect(); load(); }
      }, { rootMargin: '600px 0px' });
      io.observe(root);
    } else {
      load();
    }
  }
</script>
