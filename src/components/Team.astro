---
import { Image } from 'astro:assets';
import PersonCard from './Person.astro';
import { CORE_TEAM, ADVISORS } from '../data/site';
import teaching from '../assets/photos/team-teaching-ur5.jpg';
---
<section class="section" id="team" aria-labelledby="team-title">
  <div class="container">
    <div class="section__head reveal">
      <p class="eyebrow">Team</p>
      <h2 id="team-title">Robotics research, built for the factory floor.</h2>
      <p class="lead team__tagline">Technion research in reinforcement learning and 3D vision, with advisors from enterprise software and northern Israeli industry.</p>
    </div>
    <div class="team">
      <figure class="team__media reveal">
        <Image src={teaching} alt="Three RuRobotics team members teaching a UR5 cobot using the teach pendant" widths={[480, 960]} sizes="(min-width: 1000px) 420px, 100vw" />
      </figure>
      <div class="team__groups">
        <div class="team__group reveal">
          <h3 class="team__label">Core team</h3>
          <ul class="people people--core">{CORE_TEAM.map((p) => <PersonCard person={p} />)}</ul>
        </div>
        <div class="team__group reveal">
          <h3 class="team__label">Advisors</h3>
          <ul class="people people--advisors">{ADVISORS.map((p) => <PersonCard person={p} />)}</ul>
        </div>
      </div>
    </div>
  </div>
</section>
