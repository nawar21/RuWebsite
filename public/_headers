# Cloudflare Pages response headers (GitHub Pages ignores this file).
# The Content Security Policy itself is a <meta> tag that Astro writes into every page
# (security.csp in astro.config.mjs); frame-ancestors only works as a header, so it is here.
/*
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Hashed build assets never change, so browsers may keep them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
